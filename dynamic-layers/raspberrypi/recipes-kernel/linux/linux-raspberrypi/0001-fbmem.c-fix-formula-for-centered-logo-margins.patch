From 79e15be1ab5874e22560485e5017f8ac9911d36f Mon Sep 17 00:00:00 2001
From: Dit Kozmaj <dit.kozmaj@kynetics.it>
Date: Mon, 17 Nov 2025 13:01:22 +0000
Subject: [PATCH] fbmem.c: fix formula for centered logo margins

If logo width is equal to (or up to 8 pixels less than) the
number of pixel columns (xres) the horizontal margin calculated
is negative if with the following formula:
(xres - n * (logo->width + 8) - 8) / 2
Use instead:
(xres - n * logo->width) / 2

Signed-off-by: Jacopo Dall'Aglio <jacopo.dallaglio@kynetics.com>
Signed-off-by: Dit Kozmaj <dit.kozmaj@kynetics.it>
---
 drivers/video/fbdev/core/fbmem.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/video/fbdev/core/fbmem.c b/drivers/video/fbdev/core/fbmem.c
index e21782ba1ce2..498c448ea86e 100644
--- a/drivers/video/fbdev/core/fbmem.c
+++ b/drivers/video/fbdev/core/fbmem.c
@@ -510,7 +510,7 @@ static int fb_show_logo_line(struct fb_info *info, int rotate,
 
 		while (n && (n * (logo->width + 8) - 8 > xres))
 			--n;
-		image.dx = (xres - (n * (logo->width + 8) - 8)) / 2;
+		image.dx = (xres - n * logo->width) / 2;
 		image.dy = y ?: (yres - logo->height) / 2;
 	} else {
 		image.dx = 0;
-- 
2.25.1

